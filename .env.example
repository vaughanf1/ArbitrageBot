# ───────────────────── Cesar Arb Bot — environment ─────────────────────
# Copy to .env and fill in. The setup-bot will walk you through this.

# Mode: paper | live
TRADING_MODE=paper

# ─── Live-execution safety gate (read before going live) ───
# A venue places REAL orders only when ALL of these line up:
#   1. TRADING_MODE=live
#   2. the venue is listed in LIVE_VENUES (comma-separated), AND
#   3. EXECUTION_DRY_RUN=false
# Leave EXECUTION_DRY_RUN=true (default) to sign + validate orders against real
# credentials WITHOUT sending them — prove the path works first, then flip it.
# Example to go live on Kalshi: TRADING_MODE=live, LIVE_VENUES=kalshi, then
# (only after a clean dry run) EXECUTION_DRY_RUN=false.
LIVE_VENUES=
EXECUTION_DRY_RUN=true
# Protect small accounts from tying capital up for months. Longer/unknown
# settlement baskets stay visible but cannot auto-trade.
MAX_SETTLEMENT_DAYS=14

# Control-plane auth. Required for changing limits, start/stop, and resuming
# after a kill (fail-closed: unset = those controls are locked). Generate a
# long random string, set it here / in Railway, and paste the same value into
# the dashboard's Controls page. Engaging the kill switch never needs it.
CONTROL_TOKEN=

# Database — leave blank for local SQLite
DATABASE_URL=

# Engine HTTP API
ENGINE_PORT=4000
ENGINE_HOST=0.0.0.0

# Dashboard
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
DASHBOARD_PORT=3000

# ─── Risk limits (USD) ───
MAX_TRADE_SIZE_USD=100
MAX_DAILY_EXPOSURE_USD=500
MAX_DAILY_LOSS_PCT=5
TRAILING_STOP_PCT=5
MIN_SPREAD_PCT=1.0

# Prediction-pair matcher: 'allowlist' (only confirmed Poly↔Kalshi pairs in
# packages/scanners/src/prediction-pairs.ts — zero false positives, default)
# or 'strict' (heuristic with similarity + named-entity contradiction check —
# noisier, review trades before trusting).
PREDICTION_MATCH_MODE=allowlist

# ─── BitGet (crypto) — required for live; not needed for paper ───
# Sign up: https://partner.bitget.com/bg/<your-affiliate-tag>
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# ─── Polymarket — required for prediction-market arb ───
# PRIVATE_KEY: exported wallet key (reveal.magic.link/polymarket). FUNDER_ADDRESS:
# the proxy wallet address that holds funds (shown in Polymarket profile). The
# API key/secret/passphrase are OPTIONAL — if blank, they're derived from the key.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ─── Polymarket US (QCEX) — the CFTC-regulated US exchange ───
# Separate venue from global Polymarket with separate accounts/funds. Create
# an API key at polymarket.us/developer (needs KYC via the US app first):
# KEY_ID is the UUID, SECRET_KEY the base64 secret. No wallets involved.
# Add "polymarket-us" to LIVE_VENUES to allow live trading on it.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# ─── Kalshi — required for prediction-market arb ───
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ─── Reporting ───
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
RESEND_API_KEY=
