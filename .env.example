# ───────────────────── Cesar Arb Bot — environment ─────────────────────
# Copy to .env and fill in. The setup-bot will walk you through this.

# Mode: paper | live
TRADING_MODE=paper

# Database — leave blank for local SQLite
DATABASE_URL=

# Engine HTTP API
ENGINE_PORT=4000
ENGINE_HOST=0.0.0.0

# Dashboard
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
DASHBOARD_PORT=3000

# ─── Risk limits (USD) ───
MAX_TRADE_SIZE_USD=100
MAX_DAILY_EXPOSURE_USD=500
MAX_DAILY_LOSS_PCT=5
TRAILING_STOP_PCT=5
MIN_SPREAD_PCT=1.0

# Prediction-pair matcher: 'allowlist' (only confirmed Poly↔Kalshi pairs in
# packages/scanners/src/prediction-pairs.ts — zero false positives, default)
# or 'strict' (heuristic with similarity + named-entity contradiction check —
# noisier, review trades before trusting).
PREDICTION_MATCH_MODE=allowlist

# ─── BitGet (crypto) — required for live; not needed for paper ───
# Sign up: https://partner.bitget.com/bg/<your-affiliate-tag>
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# ─── Polymarket — required for prediction-market arb ───
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ─── Kalshi — required for prediction-market arb ───
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ─── Reporting ───
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
RESEND_API_KEY=
